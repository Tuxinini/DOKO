# Material de referencia y branding original (se queda en disco, fuera del repo)
_archivo/

# Manual de marca y plantilla de cotización oficiales (documentación pesada,
# se queda en disco como referencia pero no se versiona para mantener el repo liviano)
diseño Doko/

# Fotos originales sin procesar de proyectos terminados (varios GB, zips de Drive).
# Las versiones optimizadas para web ya viven en assets/proyectos/ y sí se versionan.
Terminados/

# Video original sin comprimir del recorrido (30MB+). La versión optimizada
# para web ya vive en assets/recorrido.mp4 y sí se versiona.
Media/

# Configuración local de herramientas
.claude/

# Basura de sistema operativo
Thumbs.db
Desktop.ini
.DS_Store
